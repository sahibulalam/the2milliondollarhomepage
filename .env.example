# Copy to .env and fill in, then:  set -a; source .env; set +a; python3 app.py

# --- database -------------------------------------------------------------
# Unset: SQLite at data/app.db, for running as a normal process.
# Set:   Postgres, which is what serverless hosting (Vercel) requires.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- where it runs --------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# The URL a browser reaches this site on. Dodo redirects the payer back here,
# so on a deployed box this MUST be the real public https:// origin.
BASE_URL=http://127.0.0.1:8787

# --- dodo payments --------------------------------------------------------
# test -> test.dodopayments.com, live -> live.dodopayments.com
DODO_MODE=test
DODO_API_KEY=
# One SINGLE PAYMENT product with "Pay What You Want" pricing enabled. Every
# area checks out against it; the bid is sent per-checkout as the cart amount.
DODO_PRODUCT_ID=
# From the webhook endpoint's Overview tab in the Dodo dashboard.
DODO_WEBHOOK_KEY=

# --- presentation ---------------------------------------------------------
SITE_NAME="the2milliondollarhomepage"
SITE_TAGLINE="Two million pixels. A dollar each. Yours for good."
TWITTER_HANDLE=          # just the handle, no @ -- blank hides the link

# --- the canvas -----------------------------------------------------------
GRID_COLS=1415            # 1415 x 1415 = 2,002,225 pixels (square)
GRID_ROWS=1415
TILE_PX=1                 # one real pixel per unit of sale
PIXEL_CENTS=100           # $1 a pixel
# TILE_FLOOR_CENTS=100    # set directly to break the per-pixel relationship
MAX_TILES_PER_CLAIM=250000 # biggest box one payment may cover
# For the original block model instead: GRID_COLS=100 GRID_ROWS=100 TILE_PX=10

# --- sale rules -----------------------------------------------------------
CURRENCY=USD
# Sold pixels stay sold. There is no outbidding, so there is nothing to tune.
CLAIM_TTL_SECONDS=1800    # unpaid claims expire after 30 minutes
MAX_LOGO_BYTES=48000   # buyers' artwork, stored in the DB
